AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__PARALLELISM=4
AIRFLOW__WEBSERVER__SECRET_KEY=nf-project-spark
AIRFLOW__SCHEDULER__MIN_FILE_PROCESS_INTERVAL=30
AIRFLOW_CONN_SPARK_DEFAULT={"conn_type": "spark", "host": "spark://spark-master", "port": 7077, "extra": {"deploy-mode": "client"}}
PYTHONPATH=/opt/airflow
HADOOP_USER_NAME=root

# Параметры пайплайна (см. pipeline/settings.py)
LANDING_DIR=/opt/airflow/data/landing
WEBHDFS_URL=http://namenode:9870
HDFS_URI=hdfs://namenode:9000
DATALAKE_ROOT=/datalake
TX_PER_MONTH=1000000
DATA_SCALE=3
